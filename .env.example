# ── Solana Network ──────────────────────────────────────────
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com

# ── Program ─────────────────────────────────────────────────
# Update this after running `anchor deploy`
PROGRAM_ID=STreasury111111111111111111111111111111111

# ── Wallet ──────────────────────────────────────────────────
NOMAD_KEYPAIR_PATH=./nomad_keypair.json

# ── Treasury Thresholds ─────────────────────────────────────
# 10 SOL in lamports
BOUNTY_THRESHOLD_LAMPORTS=10000000000
# 0.5 SOL daily rent
DAILY_RENT_LAMPORTS=500000000

# ── Income Split Ratios ─────────────────────────────────────
RESERVE_RATIO=0.60
RENT_RATIO=0.25
BOUNTY_RATIO=0.15

# ── Akash Payment ───────────────────────────────────────────
AKASH_PAYMENT_ADDRESS=

# ── Runway ──────────────────────────────────────────────────
MIN_RUNWAY_DAYS=3
